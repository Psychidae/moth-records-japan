{
  "name": "moth-records-japan",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node --experimental-strip-types scripts/prepare-public-site.ts && tsc --outDir dist && pnpm --filter @moth/app-public build && node --experimental-strip-types scripts/verify-public-site.ts",
    "build:release": "node --experimental-strip-types scripts/prepare-public-site.ts --release && tsc --outDir dist && pnpm --filter @moth/app-public build && node --experimental-strip-types scripts/verify-public-site.ts",
    "dev": "MOTH_PUBLIC_BOOTSTRAP=1 node --experimental-strip-types scripts/prepare-public-site.ts && pnpm --filter @moth/app-public dev",
    "preview": "pnpm --filter @moth/app-public preview",
    "seed:generate": "node --experimental-strip-types supabase/seed.ts",
    "test:schema-smoke": "node scripts/test-schema-smoke.mjs",
    "import:listmj": "node --experimental-strip-types pipelines/import-listmj/src/cli.ts",
    "import:listmj-annotations": "node --experimental-strip-types pipelines/import-listmj/src/annotations-cli.ts",
    "import:regions": "node --experimental-strip-types pipelines/regions/src/cli.ts",
    "sync:inat": "node --experimental-strip-types pipelines/sync-inat/src/cli.ts",
    "sync:gbif": "node --experimental-strip-types pipelines/sync-gbif/src/cli.ts",
    "build:public-data": "node --experimental-strip-types pipelines/build-public-data/src/cli.ts",
    "verify:public-data": "node --experimental-strip-types pipelines/build-public-data/src/verify-cli.ts"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "eslint": "10.13.0",
    "typescript-eslint": "8.72.1",
    "@types/node": "24.19.2",
    "@electric-sql/pglite": "0.5.13"
  }
}
