---
interface Props {id:string; label:string; name?:string; required?:boolean; error?:string; value?:string; type?:string}
const {id,label,name=id,required=false,error,value='',type='text'}=Astro.props;
---
<div class="field"><label for={id}>{label}{required && '（必須）'}</label><input id={id} name={name} type={type} required={required} value={value} aria-invalid={error ? 'true' : undefined} aria-describedby={error ? `${id}-error` : undefined}/>{error && <p id={`${id}-error`} class="field-error">{error}</p>}</div>
